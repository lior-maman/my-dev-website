extends layout

block content
  main.main
    section.section#edit-intro
      .container-modern
        h1.hero-title
          | Content Editor
        p.hero-description(style="color: var(--bs-warning);")
          | Admin mode. Edits are written straight to the live database and take effect immediately — there is no undo.
        a.btn-modern.btn-secondary-modern(href="/")
          i.bi.bi-arrow-left.me-2
          | Return to Main Site

    // Edit Projects
    section.section#edit-projects
      .container-modern
        h2.text-center.mb-3 Edit Projects
        p.text-center.text-muted-modern.mb-5
          | Change any field below and click Save to write that card to MongoDB. Changes are live immediately.

        .row.g-4
          if projects
            each project in projects
              .col-lg-4.col-md-6
                //- data-project-id חיוני ל-admin.js — לא לשנות.
                .card-modern.h-100(data-project-id=project._id)
                  img.card-img-top(src=`/img/projects/${project.imageCover}`, alt=project.name)

                  .card-modern-body
                    .mb-3
                      label.form-label(for=`name-${project._id}`) Project Name
                      //- class project-name-input חיוני ל-admin.js.
                      input.form-control.project-name-input(type="text" value=project.name)

                    .mb-3
                      label.form-label(for=`summary-${project._id}`) Summary
                      //- class project-summary-input חיוני ל-admin.js.
                      textarea.form-control.project-summary-input(rows="4")= project.summary

                    if project.tags
                      .card-tags
                        each tag in project.tags
                          span.card-tag= tag

                  .card-modern-footer
                    //- class btn-save-project חיוני ל-admin.js.
                    button.btn-modern.btn-primary-modern.w-100.btn-save-project(type="button")
                      i.bi.bi-save.me-2
                      | Save Changes

    // Tours (Legacy Data)
    section.section#edit-tours
      .container-modern
        h2.text-center.mb-3 Tours (Legacy Data)
        p.text-center.text-muted-modern.mb-5
          | Tour records pulled from the database. Read-only here — edit via the tours admin.

        .row.g-4
          if tours
            each tour in tours
              .col-lg-4.col-md-6
                .card-modern.h-100
                  img.card-img-top(src=`/img/tours/${tour.imageCover}`, alt=tour.name)
                  .card-modern-body
                    h3.card-modern-title= tour.name
                    p.card-modern-description= tour.summary
                  .card-modern-footer
                    .d-flex.justify-content-between.align-items-center
                      span.card-tag $#{tour.price}
                      a.btn-modern.btn-outline-modern(href=`/tour/${tour.slug}`) View Details
