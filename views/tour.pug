extends layout

//- Feeds the dynamic <title> in the layout head
block variables
  - var title = `${tour.name} | Financial Dashboard`
  - var description = `Duration: ${tour.duration} days`

//- Only the dynamic bits stay in CSS (cover image differs per tour)
block styles
  style.
    .tour-hero {
      background-image:
        linear-gradient(rgba(0,0,0,.55), rgba(0,0,0,.55)),
        url('/img/tours/#{tour.imageCover}');
      background-size: cover;
      background-position: center;
    }

block content

  header.section.tour-hero.text-center.text-white.d-flex.align-items-center
    .container-modern
      h1.display-2.fw-bold.mb-3= tour.name
      p.lead.mb-0= `Duration: ${tour.duration} days`

  section.section
    .container-modern
      .row.g-4

        //- Overview
        .col-lg-8
          .surface.p-4.p-md-5.h-100
            h2.mb-3 Overview
            p.lead= tour.description

        //- Details sidebar
        .col-lg-4
          .surface.p-4.p-md-5.h-100
            h4.mb-3 Details

            ul.list-unstyled.mb-4
              li.d-flex.justify-content-between.py-2.border-bottom.border-modern
                span.text-muted-modern Difficulty
                span.fw-semibold= tour.difficulty
              li.d-flex.justify-content-between.py-2.border-bottom.border-modern
                span.text-muted-modern Price
                span.fw-semibold= `$${tour.price}`
              li.d-flex.justify-content-between.py-2
                span.text-muted-modern Group Size
                span.fw-semibold= `Max ${tour.maxGroupSize} people`

            a.btn-modern.btn-primary-modern.w-100(href="#book-now")
              | View Details
              i.bi.bi-box-arrow-up-right
