.card
  .card__header
    .card__picture
      .card__picture-overlay &nbsp;
      img.card__picture-img(src='img/tour-1-cover.jpg' alt='Sector cover')
    h3.heading-tertirary
      span AI Power

  .card__details
    h4.card__sub-heading 12-name AI universe
    p.card__text Chipmakers, server builders, and the data centers powering the AI buildout
    .card__data
      svg.card__icon
        use(xlink:href='img/icons.svg#icon-map-pin')
      span US equities & ETFs
    .card__data
      svg.card__icon
        use(xlink:href='img/icons.svg#icon-calendar')
      span Delayed quotes
    .card__data
      svg.card__icon
        use(xlink:href='img/icons.svg#icon-flag')
      span RVOL & breakout
    .card__data
      svg.card__icon
        use(xlink:href='img/icons.svg#icon-user')
      span 12 tickers

  .card__footer
    p
      span.card__footer-value 12
      span.card__footer-text tickers
    p.card__ratings
      span.card__footer-value Live
      span.card__footer-text SEC filings
    a.btn.btn--green.btn--small(href='#') View Signals
