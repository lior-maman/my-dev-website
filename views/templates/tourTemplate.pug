section.section-cta
  .cta
    .cta__img.cta__img--logo
      img(src='/img/logo-white.png' alt='Logo')
    img.cta__img.cta__img--1(src='/img/tour-5-2.jpg' alt='')
    img.cta__img.cta__img--2(src='/img/tour-5-1.jpg' alt='')
    .cta__content
      h2.heading-secondary Read the tape before the crowd does.
      p.cta__text Twelve names, one dial, live market signals. Try the demo — no signup.
      button.btn.btn--green.span-all-rows Launch the Live Demo
