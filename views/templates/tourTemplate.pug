section.section-header
  .header__hero
    .header__hero-overlay &nbsp;
    img.header__hero-img(src='/img/tour-5-cover.jpg' alt='Sector cover')

  .heading-box
    h1.heading-primary
      span AI Power
    .heading-box__group
      .heading-box__detail
        svg.heading-box__icon
          use(xlink:href='/img/icons.svg#icon-clock')
        span.heading-box__text Delayed quotes
      .heading-box__detail
        svg.heading-box__icon
          use(xlink:href='/img/icons.svg#icon-map-pin')
        span.heading-box__text US equities & ETFs

section.section-description
  .overview-box
    div
      .overview-box__group
        h2.heading-secondary.ma-bt-lg Sector snapshot
        .overview-box__detail
          svg.overview-box__icon
            use(xlink:href='/img/icons.svg#icon-calendar')
          span.overview-box__label Data
          span.overview-box__text Delayed quotes
        .overview-box__detail
          svg.overview-box__icon
            use(xlink:href='/img/icons.svg#icon-trending-up')
          span.overview-box__label Signals
          span.overview-box__text RVOL & 30-day breakout
        .overview-box__detail
          svg.overview-box__icon
            use(xlink:href='/img/icons.svg#icon-user')
          span.overview-box__label Universe
          span.overview-box__text 12 curated names
        .overview-box__detail
          svg.overview-box__icon
            use(xlink:href='/img/icons.svg#icon-star')
          span.overview-box__label Filings
          span.overview-box__text SEC EDGAR, live

      .overview-box__group
        h2.heading-secondary.ma-bt-lg Data sources
        .overview-box__detail
          img.overview-box__img(src='/img/users/user-19.jpg' alt='Market data')
          span.overview-box__label Quotes
          span.overview-box__text Yahoo Finance
        .overview-box__detail
          img.overview-box__img(src='/img/users/user-18.jpg' alt='Fundamentals')
          span.overview-box__label Fundamentals
          span.overview-box__text Finnhub
        .overview-box__detail
          img.overview-box__img(src='/img/users/user-17.jpg' alt='Filings')
          span.overview-box__label Filings
          span.overview-box__text SEC EDGAR

  .description-box
    h2.heading-secondary.ma-bt-lg About the AI Power sector
    p.description__text A focused universe of the companies powering the AI buildout — chipmakers, server builders, data-center operators, and the utilities feeding them. Turn the dial to sweep the group; price, volume, breakout status, and SEC filings update instantly for whatever you land on.
    p.description__text The scanner ranks the whole group by relative volume and flags any name closing above its 30-day high, so the sector's hottest setup surfaces first — with market-wide fear and trend gauges to set the backdrop.

section.section-pictures
  .picture-box
    img.picture-box__img.picture-box__img--1(src='/img/tour-5-1.jpg' alt='AI Power sector 1')
  .picture-box
    img.picture-box__img.picture-box__img--2(src='/img/tour-5-2.jpg' alt='AI Power sector 2')
  .picture-box
    img.picture-box__img.picture-box__img--3(src='/img/tour-5-3.jpg' alt='AI Power sector 3')

