extends layout

block content

  //- Hero
  section.hero#intro

    .hero-content

      span.hero-eyebrow Market Signals, Decoded

      h1.hero-title
        | Read the tape
        br
        span.hero-title-gradient before the crowd does.

      p.hero-description
        | A live market scanner for unusual volume, fresh breakouts, and market-wide fear — across ten curated sectors.

      .hero-actions
        a.btn-modern.btn-primary-modern.btn-glow(href="#Dashboard")
          i.bi.bi-grid
          span Try the Live Demo

        a.btn-modern.btn-secondary-modern(href="#footer")
          i.bi.bi-envelope
          span Contact

      .hero-tech
        span RVOL Scanner
        span 30-Day Breakouts
        span Fear Index
        span SEC Filings
        span 10 Sectors
        span Delayed Quotes

  //- Financial Dashboard
  section.section#Dashboard

    .container-modern

      h2.text-center.mb-3 The Financial Dashboard

      p.text-center.text-muted-modern.mb-5
        | Pick a sector, turn the dial, and watch the signals update against real market data.

      .row.g-4

        if projects
          each project, i in projects
            if i === 0

              .col-12

                .project-banner(style=`background-image: url('/img/projects/${project.imageCover}')`)

                  .project-banner-overlay

                  .project-banner-content

                    h3.project-banner-title= project.name

                    p.project-banner-description= project.summary

                    if project.tags
                      .card-tags
                        each tag in project.tags
                          span.card-tag= tag

                    a.btn-modern.project-banner-btn(href=project.link)= project.buttonText



  //- Companies (previously called tours)
  section.section#Companies

    .container-modern

      h2.text-center.mb-3 Ten Sectors, One Dial

      p.text-center.text-muted-modern.mb-5
        | From AI and defense to biotech and energy — each sector is a focused watchlist, not a firehose.
        | Turn one dial to move between all ten, and land on any stock to see its latest SEC filings,
        | pulled straight from EDGAR in plain English.
      .row.g-4

        if tours
          each tour in tours

            .col-lg-4.col-md-6

              .card-modern.h-100

                img(
                  src=`/img/tours/${tour.imageCover}`
                  alt=tour.name
                  class=tour.isicon ? 'card-icon' : ''
                )

                .card-modern-body

                  h3.card-modern-title= tour.name

                  p.card-modern-description= tour.summary

                .card-modern-footer

                  .d-flex.justify-content-between.align-items-center

                    span.card-tag
                      | $#{tour.price}

                    a.btn-modern.btn-outline-modern(href=`/tour/${tour.slug}`)
                      span Details

  //- Analytics
  section.section#Analytics

    .container-modern

      h2.text-center.mb-5 The Signals

      .row.g-4

        .col-md-4
          .card-modern
            .card-modern-body.text-center
              i.bi.bi-speedometer2.fs-1.mb-3
              h3.card-modern-title Volume Scanner
              p.card-modern-description
                | Relative volume flags unusual activity the moment it happens —
                | ranked hottest-first across the whole sector.

        .col-md-4
          .card-modern
            .card-modern-body.text-center
              i.bi.bi-buildings.fs-1.mb-3
              h3.card-modern-title Breakout 30D
              p.card-modern-description
                | Spot stocks closing above their 30-day high,
                | with exactly how far above the line they broke.

        .col-md-4
          .card-modern
            .card-modern-body.text-center
              i.bi.bi-graph-up-arrow.fs-1.mb-3
              h3.card-modern-title Fear & Trend Gauges
              p.card-modern-description
                | Read the VIX, the dollar, and the S&P's trend —
                | each scored 1 to 10, all in one glance.

        .col-md-4
          .card-modern
            .card-modern-body.text-center
              i.bi.bi-fire.fs-1.mb-3
              h3.card-modern-title Breakout Quality
              p.card-modern-description
                | Scores the current setup 1 to 10 by blending volatility
                | compression, RSI, MACD and volume into one clean read.

        .col-md-4
          .card-modern
            .card-modern-body.text-center
              i.bi.bi-activity.fs-1.mb-3
              h3.card-modern-title Volatility
              p.card-modern-description
                | Ranks today's ATR against its own trailing year —
                | so calm or extreme reads the same on any ticker.

        .col-md-4
          .card-modern
            .card-modern-body.text-center
              i.bi.bi-lightbulb.fs-1.mb-3
              h3.card-modern-title Auto Analysis
              p.card-modern-description
                | Reads volume and breakout together into one call —
                | flagging the strongest combined signal, plus market fear.
