extends layout

//- Feeds the dynamic <title> in the layout head
block variables
  - var title = `${project.name} | Financial Dashboard`
  - var description = project.summary

//- Only the dynamic bits stay in CSS (cover image differs per project)
block styles
  style.
    .project-hero {
      background-image:
        linear-gradient(rgba(0,0,0,.55), rgba(0,0,0,.55)),
        url('/img/projects/#{project.imageCover}');
      background-size: cover;
      background-position: center;
    }

block content

  header.section.project-hero.text-center.text-white.d-flex.align-items-center
    .container-modern
      h1.display-2.fw-bold.mb-3= project.name
      p.lead.mb-0= project.summary

  section.section
    .container-modern
      .row.g-4

        //- Overview
        .col-lg-8
          .surface.p-4.p-md-5.h-100
            h2.mb-3 Overview
            p.lead= project.description

            if project.tags && project.tags.length
              h3.h5.mt-4 Built With
              .card-tags.mt-3
                each tag in project.tags
                  span.card-tag= tag

        //- Details sidebar
        .col-lg-4
          .surface.p-4.p-md-5.h-100
            h4.mb-3 Details

            ul.list-unstyled.mb-4
              li.d-flex.justify-content-between.py-2.border-bottom.border-modern
                span.text-muted-modern Price
                span.fw-semibold
                  if project.price
                    = `$${project.price}`
                  else
                    | Open Source / N/A

              if project.link
                li.d-flex.justify-content-between.py-2
                  span.text-muted-modern Live Demo
                  span.badge.bg-success.align-self-center Available

            if project.link
              a.btn-modern.btn-primary-modern.w-100(href=project.link target="_blank" rel="noopener")
                | Launch Live Demo
                i.bi.bi-box-arrow-up-right
